{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "runai": {
      "type": "object",
      "properties": {
        "projectName": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^REPLACE_"
          }
        }
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "milvus": {
          "type": "object",
          "properties": {
            "gpuFraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
