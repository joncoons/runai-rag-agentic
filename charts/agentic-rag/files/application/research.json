{
  "automountServiceAccountToken": false,
  "containers": [
    {
      "name": "application",
      "image": "${APPLICATION_IMAGE}",
      "imagePullPolicy": "Always",
      "command": [
        "python"
      ],
      "args": [
        "-m",
        "application.research_worker"
      ],
      "env": [
        {
          "name": "POSTGRES_DSN",
          "valueFrom": {
            "secretKeyRef": {
              "name": "${RUNTIME_SECRET}",
              "key": "POSTGRES_DSN"
            }
          }
        },
        {
          "name": "REDIS_URL",
          "valueFrom": {
            "secretKeyRef": {
              "name": "${RUNTIME_SECRET}",
              "key": "REDIS_URL"
            }
          }
        },
        {
          "name": "ARTIFACT_ROOT",
          "value": "/artifacts"
        },
        {
          "name": "MODEL_BINDINGS_FILE",
          "value": "/app/config/model-bindings.json"
        },
        {
          "name": "INGEST_STREAM_PREFIX",
          "value": "rag.agentic"
        },
        {
          "name": "ES_ENDPOINT",
          "valueFrom": {
            "secretKeyRef": {
              "name": "${RUNTIME_SECRET}",
              "key": "ES_ENDPOINT"
            }
          }
        },
        {
          "name": "MILVUS_URI",
          "valueFrom": {
            "secretKeyRef": {
              "name": "${RUNTIME_SECRET}",
              "key": "MILVUS_URI"
            }
          }
        },
        {
          "name": "ES_CA",
          "value": "/etc/rag-agentic-es/ca.crt"
        },
        {
          "name": "LLM_ENDPOINT",
          "value": "${LLM_ENDPOINT}"
        },
        {
          "name": "LLM_MODEL",
          "value": "nvidia/nemotron-3.5-super-vl-120b-a12b"
        },
        {
          "name": "OCR_MODEL_DIGEST",
          "value": "${OCR_MODEL_DIGEST}"
        },
        {
          "name": "CAPTION_MODEL_DIGEST",
          "value": "${CAPTION_MODEL_DIGEST}"
        },
        {
          "name": "ES_USER",
          "valueFrom": {
            "secretKeyRef": {
              "name": "${RUNTIME_SECRET}",
              "key": "ES_READER_USER"
            }
          }
        },
        {
          "name": "ES_PASSWORD",
          "valueFrom": {
            "secretKeyRef": {
              "name": "${RUNTIME_SECRET}",
              "key": "ES_READER_PASSWORD"
            }
          }
        },
        {
          "name": "QUERY_MCP_HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "QUERY_MCP_PORT",
          "value": "8011"
        },
        {
          "name": "LOCATION_ROOTS_FILE",
          "value": "/app/config/location-roots.json"
        },
        {
          "name": "EMBED_INPUT_CONTRACT",
          "value": "/app/config/embedding-input-contract.json"
        },
        {
          "name": "MODEL_CONTRACTS_FILE",
          "value": "/app/config/model-contracts.json"
        },
        {
          "name": "MILVUS_TOKEN",
          "valueFrom": {
            "secretKeyRef": {
              "name": "${RUNTIME_SECRET}",
              "key": "MILVUS_TOKEN"
            }
          }
        }
      ],
      "resources": {
        "requests": {
          "cpu": "250m",
          "memory": "512Mi"
        },
        "limits": {
          "cpu": "2",
          "memory": "2Gi"
        }
      },
      "volumeMounts": [
        {
          "name": "tmp",
          "mountPath": "/tmp"
        },
        {
          "name": "es-ca",
          "mountPath": "/etc/rag-agentic-es",
          "readOnly": true
        },
        {
          "name": "artifacts",
          "mountPath": "/artifacts",
          "readOnly": false
        },
        {
          "name": "configuration",
          "mountPath": "/app/config",
          "readOnly": true
        }
      ],
      "securityContext": {
        "runAsUser": 1000,
        "runAsGroup": 1000,
        "runAsNonRoot": true,
        "allowPrivilegeEscalation": false,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        }
      },
      "readinessProbe": {
        "httpGet": {
          "path": "/health/ready",
          "port": 8089
        },
        "periodSeconds": 10
      }
    }
  ],
  "volumes": [
    {
      "name": "tmp",
      "emptyDir": {
        "sizeLimit": "2Gi"
      }
    },
    {
      "name": "es-ca",
      "secret": {
        "secretName": "${ES_CA_SECRET}"
      }
    },
    {
      "name": "artifacts",
      "persistentVolumeClaim": {
        "claimName": "${ARTIFACT_PVC}",
        "readOnly": false
      }
    },
    {
      "name": "configuration",
      "persistentVolumeClaim": {
        "claimName": "${CONFIG_PVC}",
        "readOnly": true
      }
    }
  ],
  "terminationGracePeriodSeconds": 30
}
