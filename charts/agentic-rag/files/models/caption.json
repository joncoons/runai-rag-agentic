{
  "automountServiceAccountToken": false,
  "containers": [
    {
      "name": "application",
      "image": "nvcr.io/nim/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:latest",
      "imagePullPolicy": "Always",
      "args": [
        "--max-num-seqs",
        "1",
        "--gpu-memory-utilization",
        "0.85",
        "--max-model-len",
        "8192"
      ],
      "env": [
        {
          "name": "NIM_MODEL_PROFILE",
          "value": "${MODEL_PROFILE}"
        },
        {
          "name": "NIM_SERVED_MODEL_NAME",
          "value": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
        },
        {
          "name": "NIM_CACHE_PATH",
          "value": "/opt/nim/.cache"
        },
        {
          "name": "NIM_WRITABLE_ROOT",
          "value": "/opt/cache"
        },
        {
          "name": "NIM_LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "NIM_MAX_MODEL_LEN",
          "value": "8192"
        },
        {
          "name": "CUDA_CACHE_PATH",
          "value": "/opt/cache/cuda"
        },
        {
          "name": "TRITON_CACHE_DIR",
          "value": "/opt/cache/triton"
        },
        {
          "name": "TORCHINDUCTOR_CACHE_DIR",
          "value": "/opt/cache/torchinductor"
        },
        {
          "name": "VLLM_CACHE_ROOT",
          "value": "/opt/cache/vllm"
        },
        {
          "name": "PYTHONDONTWRITEBYTECODE",
          "value": "1"
        }
      ],
      "resources": {
        "requests": {
          "cpu": "1",
          "memory": "8Gi"
        }
      },
      "volumeMounts": [
        {
          "name": "checkpoint",
          "mountPath": "/opt/nim/.cache",
          "readOnly": false
        },
        {
          "name": "runtime-cache",
          "mountPath": "/opt/cache",
          "readOnly": false,
          "subPath": "${GPU_CACHE_SUBPATH}"
        },
        {
          "name": "shm",
          "mountPath": "/dev/shm"
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "checkpoint",
      "persistentVolumeClaim": {
        "claimName": "${MODEL_CHECKPOINT_PVC}",
        "readOnly": false
      }
    },
    {
      "name": "runtime-cache",
      "persistentVolumeClaim": {
        "claimName": "${MODEL_CACHE_PVC}",
        "readOnly": false
      }
    },
    {
      "name": "shm",
      "emptyDir": {
        "medium": "Memory",
        "sizeLimit": "8Gi"
      }
    }
  ],
  "terminationGracePeriodSeconds": 30
}
