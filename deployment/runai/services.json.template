{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "rag-agentic-api",
        "namespace": "${NAMESPACE}"
      },
      "spec": {
        "selector": {
          "workloadName": "rag-agentic-api"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": 8080,
            "protocol": "TCP"
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "rag-agentic-query-mcp",
        "namespace": "${NAMESPACE}"
      },
      "spec": {
        "selector": {
          "workloadName": "rag-agentic-query-mcp"
        },
        "ports": [
          {
            "name": "http",
            "port": 8011,
            "targetPort": 8011,
            "protocol": "TCP"
          }
        ]
      }
    }
  ]
}
