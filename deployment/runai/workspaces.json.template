{
  "api": {
    "name": "rag-agentic-api",
    "projectId": "${RUNAI_PROJECT_ID}",
    "clusterId": "${RUNAI_CLUSTER_ID}",
    "spec": {
      "image": "${APPLICATION_IMAGE}",
      "imagePullPolicy": "Always",
      "command": "python",
      "args": "-m application.api",
      "createHomeDir": false,
      "compute": {
        "cpuCoreRequest": 0.25,
        "cpuCoreLimit": 1,
        "cpuMemoryRequest": "512Mi",
        "cpuMemoryLimit": "2Gi"
      },
      "security": {
        "uidGidSource": "custom",
        "runAsUid": 1000,
        "runAsGid": 1000,
        "runAsNonRoot": true,
        "allowPrivilegeEscalation": false,
        "hostIpc": false,
        "hostNetwork": false
      },
      "environmentVariables": [
        {
          "name": "POSTGRES_DSN",
          "secret": {
            "name": "${RUNTIME_SECRET}",
            "key": "POSTGRES_DSN"
          }
        },
        {
          "name": "REDIS_URL",
          "secret": {
            "name": "${RUNTIME_SECRET}",
            "key": "REDIS_URL"
          }
        },
        {
          "name": "ARTIFACT_ROOT",
          "value": "/artifacts"
        },
        {
          "name": "MODEL_BINDINGS_FILE",
          "value": "/app/config/model-bindings.json"
        },
        {
          "name": "INGEST_STREAM_PREFIX",
          "value": "rag.agentic"
        },
        {
          "name": "ES_ENDPOINT",
          "secret": {
            "name": "${RUNTIME_SECRET}",
            "key": "ES_ENDPOINT"
          }
        },
        {
          "name": "MILVUS_URI",
          "secret": {
            "name": "${RUNTIME_SECRET}",
            "key": "MILVUS_URI"
          }
        },
        {
          "name": "ES_CA",
          "value": "/etc/rag-agentic-es/ca.crt"
        },
        {
          "name": "LLM_ENDPOINT",
          "value": "${LLM_ENDPOINT}"
        },
        {
          "name": "LLM_MODEL",
          "value": "nvidia/nemotron-3.5-super-vl-120b-a12b"
        },
        {
          "name": "OCR_MODEL_DIGEST",
          "value": "${OCR_MODEL_DIGEST}"
        },
        {
          "name": "CAPTION_MODEL_DIGEST",
          "value": "${CAPTION_MODEL_DIGEST}"
        },
        {
          "name": "QUERY_MCP_URL",
          "value": "http://rag-agentic-query-mcp.${NAMESPACE}.svc.cluster.local:8011/mcp"
        },
        {
          "name": "ES_USER",
          "secret": {
            "name": "${RUNTIME_SECRET}",
            "key": "ES_READER_USER"
          }
        },
        {
          "name": "ES_PASSWORD",
          "secret": {
            "name": "${RUNTIME_SECRET}",
            "key": "ES_READER_PASSWORD"
          }
        },
        {
          "name": "LOCAL_ADMIN_CONFIG_FILE",
          "value": "/etc/rag-agentic-admin/config.json"
        },
        {
          "name": "LOCATION_REGISTRY_DATABASE",
          "value": "true"
        },
        {
          "name": "LOCATION_ROOTS_FILE",
          "value": "/app/config/location-roots.json"
        },
        {
          "name": "EMBED_INPUT_CONTRACT",
          "value": "/app/config/embedding-input-contract.json"
        },
        {
          "name": "MODEL_CONTRACTS_FILE",
          "value": "/app/config/model-contracts.json"
        },
        {
          "name": "MILVUS_TOKEN",
          "secret": {
            "name": "${RUNTIME_SECRET}",
            "key": "MILVUS_TOKEN"
          }
        }
      ],
      "storage": {
        "pvc": [
          {
            "name": "artifacts",
            "claimName": "${ARTIFACT_PVC}",
            "existingPvc": true,
            "ephemeral": false,
            "readOnly": false,
            "path": "/artifacts"
          },
          {
            "name": "approved-source",
            "claimName": "${SOURCE_PVC}",
            "existingPvc": true,
            "ephemeral": false,
            "readOnly": true,
            "path": "/source-roots/approved"
          },
          {
            "name": "configuration",
            "claimName": "${CONFIG_PVC}",
            "existingPvc": true,
            "ephemeral": false,
            "readOnly": true,
            "path": "/app/config"
          }
        ],
        "emptyDirVolume": [
          {
            "name": "tmp",
            "path": "/tmp",
            "sizeLimit": "2Gi"
          }
        ],
        "secretVolume": [
          {
            "name": "es-ca",
            "secret": "${ES_CA_SECRET}",
            "mountPath": "/etc/rag-agentic-es"
          },
          {
            "name": "local-admin",
            "secret": "${ADMIN_SECRET}",
            "mountPath": "/etc/rag-agentic-admin"
          }
        ]
      },
      "labels": [
        {
          "name": "rag-agentic-component",
          "value": "application"
        },
        {
          "name": "rag-agentic-role",
          "value": "api"
        }
      ],
      "restartPolicy": "Always",
      "preemptibility": "non-preemptible",
      "terminationGracePeriodSeconds": 30,
      "probes": {
        "readiness": {
          "initialDelaySeconds": 5,
          "periodSeconds": 10,
          "timeoutSeconds": 5,
          "failureThreshold": 3,
          "handler": {
            "httpGet": {
              "path": "/api/status",
              "port": 8080,
              "scheme": "HTTP"
            }
          }
        }
      }
    }
  },
