flowchart TD
    API["Collection create / duplicate /<br/>upsert / delete"]
    PG[("Existing PostgreSQL database<br/>collection_control schema")]
    OUT["Transactional domain outbox"]
    WORK["Renewable lease and fenced<br/>attempt<br/>immutable content-addressed<br/>record versions"]
    ES["Persistent Elasticsearch<br/>projection<br/>incremental verified versions"]
    MV["Persistent Milvus native TEXT /<br/>vector / metadata<br/>incremental verified versions"]
    CHECK["Validate new versions and<br/>per-store receipts"]
    PUB["Atomic PostgreSQL<br/>authorized-version manifest"]
    READ["Query / MCP filter published<br/>versions BEFORE top-k<br/>revalidate before evidence<br/>release"]
    STAGE["Local EMBEDDING stage and<br/>attempt commit"]
    ADMIT["Retained bytes and complete<br/>source-unit coverage<br/>upstream IDs and per-record<br/>stage proof"]
    HTTP["HTTP first acquisition"] --> JS{"Sparse / empty main?"}
    JS -->|yes| BROWSER["Original Selenium fallback and<br/>readiness wait"]
    JS -->|no| RAW["Retained observation bytes and<br/>hashes"]
    BROWSER --> RAW
    RAW --> UNITS["Versioned main-page and<br/>audience-disclosure units"]
    UNITS --> STAGE
    STAGE --> ADMIT
    ADMIT -->|same PostgreSQL transaction| PG
    API --> PG
    PG --> OUT
    OUT --> WORK
    WORK --> ES
    WORK --> MV
    ES --> CHECK
    MV --> CHECK
    CHECK --> RECHECK["Revalidate source / job / stage<br/>/ intake proof<br/>hold source share locks through<br/>publication"]
    RECHECK --> PUB
    PUB --> PG
    READ --> PG
    READ --> ES
    READ --> MV
    REJECT["Permanent admission rejection<br/>cancel intent, preserve prior<br/>publication"]
    DELETE["Logical deletion denial barrier<br/>fence work, retain versions for<br/>governed cleanup"]
    WORK -->|admission fails| REJECT
    REJECT --> PG
    API -->|delete| DELETE
    DELETE --> PG
