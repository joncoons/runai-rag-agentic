flowchart TD
    OBS["Complete page and asset<br/>observation"]
    DIFF["Diff committed dependency<br/>manifest"]
    PG[("PostgreSQL revisions / edges /<br/>operations / outbox")]
    PROC["Nv-ingest changed assets and<br/>rebuild parent evidence"]
    STAGE["Stage page / owned documents /<br/>ES and optional Milvus"]
    PUB["Atomic PostgreSQL publication:<br/>VDB handles and asset manifest"]
    READ["Managed query and asset-serving<br/>gate"]
    GC["Reference / retention / reader /<br/>job gates"]
    PURGE["Fenced physical purge and<br/>durable receipt"]
    OBS --> DIFF
    DIFF --> PG
    PG --> PROC
    PROC --> STAGE
    STAGE --> PUB
    PUB --> READ
    PUB --> GC
    GC --> PURGE
    PURGE --> PG
