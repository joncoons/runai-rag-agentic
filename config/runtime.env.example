# Copy to local/runtime.env, set real credentials privately, and chmod 600.
POSTGRES_DSN=postgresql://APP_USER:APP_PASSWORD@POSTGRES_HOST:5432/APP_DATABASE
REDIS_URL=redis://REDIS_HOST:6379/0
ES_ENDPOINT=https://ELASTICSEARCH_HOST:9200
ES_READER_USER=REPLACE_READER_USER
ES_READER_PASSWORD=REPLACE_READER_PASSWORD
ES_WRITER_USER=REPLACE_WRITER_USER
ES_WRITER_PASSWORD=REPLACE_WRITER_PASSWORD
MILVUS_URI=http://MILVUS_HOST:19530
MILVUS_TOKEN=
